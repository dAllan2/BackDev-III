<h1>Times</h1>

<% if (times.length > 0) { %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Estádio</th>
        <th>Cidade</th>
        <th>Ação</th>
      </tr>
    </thead>
    <tbody>
      <% times.forEach((time) => { %>
        <tr>
          <td><%= time.id %></td>
          <td><%= time.nome %></td>
          <td><%= time.estadio %></td>
          <td><%= time.cidade %></td>
          <td><a href="/times/<%= time.id %>">Ver detalhes</a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } else { %>
  <p>Nenhum time cadastrado no momento.</p>
<% } %>